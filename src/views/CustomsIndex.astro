---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../data/site';
import { articles } from '../data/customs';
import { tr, pfx, altPath } from '../lib';
const { lang } = Astro.props as { lang: Lang };
const t = tr(lang); const pre = pfx(lang);
const Y = new Date().getFullYear();
---
<Base lang={lang} active="customs" alt={altPath(lang, '/customs/')}
  title={t(`华人丧礼习俗 ${Y}｜头七、白金、守孝过年怎么做｜祥鹤殡仪`, `Chinese Funeral Customs ${Y} | First Seventh Day, Condolence Money | Seong Hoe`)}
  description={t('盖棺为什么要回避、手尾钱是什么、守孝期间婚事怎么办。大家都在做、却很少人解释的华人丧礼习俗。', 'Chinese funeral customs in Malaysia explained: hand money, mourning clothes colours, the mourning staff, foot-end rice and weddings during mourning.')}>
  <PageHead crumbs={[{ href: `${pre}/`, label: t('首页', 'Home') }, { href: `${pre}/customs/`, label: t('习俗知识', 'Customs') }]}
    title={t('大家都在做的规矩，', 'Customs everyone follows,')} grey={t('很少人解释。', 'few explain.')}
    lead={t('各地、各籍贯习俗略有不同，以下讲法供大家参考，不必迷信。', 'Customs differ by place and dialect group. These are for reference.')} />
  <section class="section" style="padding-top:48px">
    <div class="wrap">
      <div class="article-grid">
        {articles.filter((a) => lang === 'zh' || a.en).map((a, i) => (
          <a class="a-card" href={lang === 'en' ? `/en/customs/${a.slug}/` : `/customs/${a.slug}/`} data-reveal style={`--d:${i % 2}`}>
            <div><h3>{lang === 'en' ? a.en!.title : a.title}</h3><p>{lang === 'en' ? a.en!.summary : a.summary}</p></div>
            <span class="disc-arrow"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
