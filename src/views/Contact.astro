---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { brand, branches, waLink, socials, type Lang } from '../data/site';
import { tr, pfx, altPath } from '../lib';
const { lang } = Astro.props as { lang: Lang };
const t = tr(lang); const pre = pfx(lang);
const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: t('联络祥鹤', 'Contact Seong Hoe'), url: new URL(`${pre}/contact/`, Astro.site!).href, about: { '@id': new URL('/#org', Astro.site!).href } };
---
<Base lang={lang} active="contact" alt={altPath(lang, '/contact/')} schema={[schema]}
  title={t('联络祥鹤｜峇株巴辖・新山・新文龙 24 小时殡仪服务电话', 'Contact Seong Hoe | 24-Hour Funeral Service in Batu Pahat, Johor Bahru, Senggarang')}
  description={t('祥鹤殡仪服务有限公司是一家位于峇株巴辖的 24 小时殡仪服务公司。总店电话 016-777 3883，新山分店 013-288 3883，宠物殡葬专线 018-909 3883。三间分店地址和地图都在这里。', 'Seong Hoe Funeral Service is based in Batu Pahat, Johor, offering 24-hour funeral services. HQ +60 16-777 3883, Johor Bahru +60 13-288 3883, pet funerals +60 18-909 3883. Addresses and maps for all three branches.')}>
  <PageHead crumbs={[{ href: `${pre}/`, label: t('首页', 'Home') }, { href: `${pre}/contact/`, label: t('联络我们', 'Contact') }]}
    title={t('联络祥鹤，', 'Contact us,')} grey={t('24 小时有人接。', 'someone always answers.')}
    lead={t('祥鹤殡仪服务有限公司是一家位于峇株巴辖的 24 小时殡仪服务公司，总店在 Taman Dagang，新山和新文龙也有分店。家里有人走了，不管几点，打电话或 WhatsApp 都有人接。', 'Seong Hoe Funeral Service is based in Batu Pahat, Johor, with our HQ in Taman Dagang and branches in Johor Bahru and Senggarang. Whatever the hour, call or WhatsApp us and someone will answer.')} />
  <section class="section" style="padding-top:40px">
    <div class="wrap split">
      <div>
        {branches.map((b) => (
          <div class="svc-sec" data-reveal>
            <h2 class="h3">{b.name[lang]}</h2>
            <div class="contact-items" style="margin:16px 0 0">
              <div class="contact-item"><span class="contact-item__icon"><Icon name="phone" /></span><div><small>{t('电话（24 小时）', 'Phone (24 hours)')}</small><a href={`tel:${b.phone}`}>{b.phoneDisplay}</a></div></div>
              <div class="contact-item"><span class="contact-item__icon"><Icon name="pin" /></span><div><small>{t('地址', 'Address')}</small><a href={b.mapsUrl} target="_blank" rel="noopener">{b.address}</a></div></div>
            </div>
            <a class="link" style="margin-top:16px" href={`${pre}/branches/${b.slug}/`}>{t(`${b.area.zh}服务和地图`, `Services and map in ${b.area.en}`)}<Icon name="arrow" /></a>
          </div>
        ))}
        <div class="svc-sec" data-reveal>
          <h2 class="h3">{t('宠物殡葬（只限峇株巴辖）', 'Pet funerals (Batu Pahat only)')}</h2>
          <div class="contact-items" style="margin:16px 0 0">
            <div class="contact-item"><span class="contact-item__icon"><Icon name="paw" /></span><div><small>{t('宠物专线', 'Pet line')}</small><a href="tel:+60189093883">+60 18-909 3883</a></div></div>
          </div>
        </div>
        <div class="svc-sec" data-reveal>
          <h2 class="h3">{t('打来之前，先准备这几样', 'Before you call')}</h2>
          <ol class="steps">
            {[
              [t('人在哪里', 'Where your loved one is'), t('医院、家里还是疗养院。', 'At a hospital, at home or in a care home.')],
              [t('家里拜什么', 'Your family’s religion'), t('佛教、道教、基督教、天主教或其他，我们照家里的习惯安排。', 'Buddhist, Taoist, Christian, Catholic or other. We arrange it your family’s way.')],
              [t('火化还是土葬', 'Cremation or burial'), t('还没决定也没关系，我们会先跟你讲清楚两种怎么做。', 'If you have not decided, we will explain both first.')],
            ].map(([h, d], i) => <li><span class="steps__n">{String(i + 1).padStart(2, '0')}</span><div><strong>{h}</strong><p>{d}</p></div></li>)}
          </ol>
        </div>
      </div>
      <aside class="side-card on-dark" data-reveal style="--d:1">
        <h3>{t('最快的方法', 'The fastest way')}</h3>
        <p style="color:var(--on-dark-muted);font-size:14.5px;margin:12px 0 20px">{t('WhatsApp 我们，讲一下家里的情况，我们马上回复。', 'WhatsApp us with your situation and we will reply straight away.')}</p>
        <a class="btn btn--light" href={waLink(lang)}>WhatsApp {brand.whatsappDisplay}<span class="disc"><Icon name="chat" /></span></a>
        <a class="btn btn--light" href={`tel:${branches[0].phone}`}>{t('打电话', 'Call')}<span class="disc"><Icon name="phone" /></span></a>
        <p style="color:var(--on-dark-muted);font-size:13.5px;margin:22px 0 8px">{t('社交平台', 'Social media')}</p>
        <ul>{socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.name}</a></li>)}</ul>
      </aside>
    </div>
  </section>
</Base>
