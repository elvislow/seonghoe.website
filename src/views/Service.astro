---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import { branches, waLink, brand, pet, petWaLink, type Lang } from '../data/site';
import { services, petPackages, petStartingPrice, petWeightBands, type Service } from '../data/services';
import { tr, pfx, altPath } from '../lib';
import { areaPages } from '../data/areas';
const { lang, service: s } = Astro.props as { lang: Lang; service: Service };
const t = tr(lang); const pre = pfx(lang);
const Y = new Date().getFullYear();
const idx = services.findIndex((x) => x.slug === s.slug);
const next = services[(idx + 1) % services.length];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs[lang].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const isPet = s.slug === 'pet-funeral';
const localPages = Object.entries(areaPages).flatMap(([area, ps]) => ps.filter((p) => p.service === s.slug).map((p) => ({ href: `${pre}/${area}/${p.slug}/`, label: p[lang].h1.replace(/[，,]$/, '') })));
const serviceSchema = { '@context': 'https://schema.org', '@type': 'Service', name: s.title[lang], description: s.intro[lang], provider: { '@id': new URL('/#org', Astro.site!).href }, areaServed: isPet ? ['Batu Pahat'] : ['Batu Pahat', 'Johor Bahru', 'Senggarang', 'Johor'] };
const areaZh = isPet ? '峇株巴辖' : '峇株巴辖・新山・新文龙';
const areaEn = isPet ? 'Batu Pahat' : 'Batu Pahat, Johor Bahru, Senggarang';
const seo = s.seo?.[lang];
const descZh = isPet ? `${s.intro.zh}祥鹤宠物殡葬只在峇株巴辖服务，宠物专线 018-909 3883。` : `祥鹤殡仪服务有限公司是一家位于峇株巴辖的 24 小时殡仪服务公司。${s.intro.zh}新山、新文龙也有分店，电话 016-777 3883。`;
const descEn = isPet ? `${s.intro.en} Pet funerals are offered in Batu Pahat only. Pet line +60 18-909 3883.` : `Seong Hoe Funeral Service is based in Batu Pahat, Johor, offering 24-hour funeral services. ${s.intro.en} Branches in Johor Bahru and Senggarang. Call +60 16-777 3883.`;
---
<Base lang={lang} waHref={isPet ? petWaLink(lang) : undefined} phone={isPet ? pet.phone : undefined} active="services" alt={altPath(lang, `/services/${s.slug}/`)}
  title={seo ? (isPet ? seo.title : seo.title.replace(/(｜| \| )/, ` ${Y}$1`)) : t(`${s.title.zh}${/[）)]$/.test(s.title.zh) ? '' : ' '}${Y}｜${areaZh}${isPet ? '' : ' 24 小时'}｜祥鹤殡仪`, `${s.title.en} ${Y} | ${areaEn}${isPet ? '' : ', 24/7'} | Seong Hoe`)}
  image={s.photo} description={seo ? seo.desc : t(descZh, descEn)} schema={[serviceSchema, faqSchema]}>
  <PageHead crumbs={[{ href: `${pre}/`, label: t('首页', 'Home') }, { href: `${pre}/services/`, label: t('服务', 'Services') }, { href: `${pre}/services/${s.slug}/`, label: s.title[lang] }]}
    title={seo?.h1 ?? s.title[lang]} grey={seo?.grey} lead={s.intro[lang]} />
  {isPet && (
    <section class="pet-pricing wrap" aria-labelledby="pet-pricing-title">
      <p class="pet-price">{t(`单炉火化 RM${petStartingPrice} 起`, `Individual cremation from RM${petStartingPrice}`)}</p>
      <div class="pet-contact">
        <a class="btn btn--dark" href={`tel:${pet.phone}`}>{pet.phoneDisplay}<span class="disc"><Icon name="phone" /></span></a>
        <a class="btn btn--primary" href={petWaLink(lang)}>WhatsApp<span class="disc"><Icon name="chat" /></span></a>
      </div>
      <h2 class="h2" id="pet-pricing-title">{t('宠物火化与殡葬配套价格', 'Pet cremation and funeral prices')}</h2>
      <p class="body">{t('费用按体重和配套计算。预约时请告诉我们宠物的体重、接送地点，以及你希望怎样处理骨灰。', 'Prices vary by weight and package. To confirm a quote, tell us your pet’s weight, the pickup location and how you would like the ashes cared for.')}</p>
      <ul class="pet-packages">
        {petPackages.map((item) => (
          <li class="pet-package">
            <h3 class="h3">{item.name[lang]}</h3>
            <dl>
              {petWeightBands[lang].map((weight, index) => (
                <div><dt>{weight}</dt><dd>RM{item.prices[index]}</dd></div>
              ))}
            </dl>
            <p class="body">{item.includes[lang]}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section class="section" style="padding-top:48px">
    <div class="wrap split">
      <div>
        {s.photo && <div class="svc-photo" data-reveal><img src={s.photo} alt={s.title[lang]} /></div>}
        {s.body[lang].map((sec) => (
          <div class="svc-sec" data-reveal>
            <h2 class="h3">{sec.h}</h2>
            {sec.p && <div class="body">{sec.p.map((x) => <p>{x}</p>)}</div>}
            {sec.steps && (
              <ol class="steps">
                {sec.steps.map(([h, d], i) => <li><span class="steps__n">{String(i + 1).padStart(2, '0')}</span><div><strong>{h}</strong><p>{d}</p></div></li>)}
              </ol>
            )}
          </div>
        ))}
        <div class="svc-sec" data-reveal>
          <h2 class="h3">{t('常见问题', 'Common questions')}</h2>
          <div class="acc" data-acc style="margin-top:12px">
            {s.faqs[lang].map(([q, a], k) => (
              <div class="acc__item">
                <button class="acc__btn" type="button" aria-expanded={k === 0 ? 'true' : 'false'}>{q}<span class="acc__plus"><Icon name="plus" size={18} /></span></button>
                <div class="acc__panel"><div><p>{a}</p></div></div>
              </div>
            ))}
          </div>
        </div>
        {localPages.length > 0 && (
          <div class="svc-sec" data-reveal>
            <h2 class="h3">{t('各地服务', 'By area')}</h2>
            <div class="tile-list">{localPages.map((p) => <a href={p.href}><span>{p.label}</span><span class="disc-arrow"><Icon name="arrow" /></span></a>)}</div>
          </div>
        )}
        <div class="svc-sec" data-reveal>
          <h2 class="h3">{t('下一个服务', 'Next service')}</h2>
          <div class="tile-list"><a href={`${pre}/services/${next.slug}/`}><span>{next.title[lang]}</span><span class="disc-arrow"><Icon name="arrow" /></span></a></div>
        </div>
      </div>
      <aside class="side-card on-dark" data-reveal style="--d:1">
        <h3>{t('24 小时联络', 'Call us 24 hours')}</h3>
        <ul>{isPet ? <li><span>{t('宠物专线', 'Pet line')}</span><a href={`tel:${pet.phone}`}>{pet.phoneDisplay}</a></li> : branches.map((b) => <li><span>{b.name[lang]}</span><a href={`tel:${b.phone}`}>{b.phoneDisplay}</a></li>)}</ul>
        <a class="btn btn--light" href={isPet ? petWaLink(lang) : waLink(lang)}>WhatsApp {isPet ? '+60 18-909 3883' : brand.whatsappDisplay}<span class="disc"><Icon name="arrow" /></span></a>
      </aside>
    </div>
  </section>
</Base>


<style>
  .pet-pricing { margin-top: 20px; }
  .pet-price { font-size: var(--fs-lead); font-weight: 700; }
  .pet-contact { display: flex; flex-wrap: wrap; gap: 10px; margin: 12px 0 clamp(28px, 4vw, 48px); }
  .pet-pricing .h2 { margin-bottom: 12px; }
  .pet-packages { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 20px; }
  .pet-package { min-width: 0; padding: clamp(16px, 2.5vw, 26px); background: var(--panel); border-radius: var(--r-tile); }
  .pet-package dl { margin: 12px 0; }
  .pet-package dl div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 5px 0; border-bottom: 1px solid var(--line); }
  .pet-package dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) { .pet-packages { grid-template-columns: minmax(0, 1fr); } }
</style>
