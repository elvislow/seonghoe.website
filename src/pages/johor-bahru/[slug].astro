---
import AreaPage from '../../views/AreaPage.astro';
import { areaPages } from '../../data/areas';
export function getStaticPaths() { return areaPages['johor-bahru'].map((page) => ({ params: { slug: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<AreaPage lang="zh" area="johor-bahru" page={page} />
