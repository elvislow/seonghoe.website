---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base lang="zh" title="找不到这一页｜祥鹤殡仪服务有限公司" description="找不到这一页。">
  <section class="page-head" style="padding-bottom:40px">
    <div class="wrap">
      <h1 class="page-title">找不到这一页，<span class="grey">回首页看看。</span></h1>
      <p style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">回首页<span class="disc"><Icon name="arrow" /></span></a>
        <a class="btn btn--ghost" href="/branches/">找分店<span class="disc"><Icon name="arrow" /></span></a>
      </p>
    </div>
  </section>
</Base>
